# Keep the build context small and deterministic.
.git
.gitignore
.venv
venv
**/__pycache__
*.py[cod]
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache

# Node — rebuilt inside the image
web/node_modules
web/dist
web/.vite

# Prebuilt static — regenerated by the web build stage
app/static

# Env / secrets — never bake into the image
.env
.env.local
*.local

# Local scratch / editor / infra state
.playwright-mcp
infra
*.png
.DS_Store
Thumbs.db
.idea
.vscode
