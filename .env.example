# Bank Alfa Mortgage AI Demo — environment configuration (no secrets committed).
# Copy to .env for local development. Auth is keyless (DefaultAzureCredential).

# --- Microsoft Foundry (Azure AI Services) ---
FOUNDRY_ENDPOINT=https://foundry-mortgage.cognitiveservices.azure.com/
VOICELIVE_MODEL=gpt-realtime-1.5

# --- Content Understanding ---
CU_API_VERSION=2025-11-01
CU_ANALYZER_ID=bankalfa-payslip

# --- Provider selection: "foundry" (real Azure) or "simulated" (deterministic, offline) ---
VOICE_PROVIDER=foundry
DOCUMENT_PROVIDER=foundry

# --- Assistant text-to-speech: "foundry" (Azure neural TTS, keyless) or "off" (browser speech) ---
TTS_PROVIDER=off
TTS_VOICE=sv-SE-SofieNeural
TTS_FORMAT=audio-24khz-48kbitrate-mono-mp3

# --- App ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
