PORT=8000
APP_ENV=local

# Both data-plane services use the Foundry account endpoint. The project
# endpoint is only for project-scoped Foundry APIs.
FOUNDRY_ACCOUNT_ENDPOINT=https://foundry-mortgage.services.ai.azure.com/
FOUNDRY_PROJECT_ENDPOINT=https://foundry-mortgage.services.ai.azure.com/api/projects/proj-default
AZURE_OPENAI_ENDPOINT=https://foundry-mortgage.openai.azure.com
AZURE_OPENAI_MODEL=gpt-5.2
AZURE_VOICELIVE_ENDPOINT=https://foundry-mortgage.services.ai.azure.com/
AZURE_VOICELIVE_MODEL=gpt-realtime-1.5
AZURE_VOICELIVE_API_VERSION=2026-04-10
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
CONTENTUNDERSTANDING_ENDPOINT=https://foundry-mortgage.services.ai.azure.com/
CONTENTUNDERSTANDING_ANALYZER_ID=mortgage_payslip

# Set this to the user-assigned managed identity client ID in Azure. Leave it
# unset locally so DefaultAzureCredential can use the Azure CLI login.
AZURE_TENANT_ID=cc48e4fe-6662-414d-aeff-4eb633735b38
AZURE_TOKEN_CREDENTIALS=AzureCliCredential
AZURE_CLIENT_ID=
APPLICATIONINSIGHTS_CONNECTION_STRING=